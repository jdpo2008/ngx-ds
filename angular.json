{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    },
    "@schematics/angular:application": {
      "style": "scss"
    }
  },
  "projects": {
    "ngx-ds": {
      "projectType": "library",
      "root": "projects/ngx-ds",
      "sourceRoot": "projects/ngx-ds/src",
      "prefix": "ngx",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ngx-ds/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-ds/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-ds/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-ds/tsconfig.spec.json",
            "runnerConfig": "projects/ngx-ds/vitest.config.mts"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/ngx-ds/.storybook",
            "browserTarget": "ngx-ds:storybook",
            "tsConfig": "projects/ngx-ds/.storybook/tsconfig.json",
            "styles": [
              "projects/ngx-ds/styles/index.scss",
              "projects/ngx-ds/.storybook/preview-theme.scss"
            ],
            "compodoc": false,
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/ngx-ds/.storybook",
            "browserTarget": "ngx-ds:build-storybook",
            "tsConfig": "projects/ngx-ds/.storybook/tsconfig.json",
            "styles": [
              "projects/ngx-ds/styles/index.scss",
              "projects/ngx-ds/.storybook/preview-theme.scss"
            ],
            "compodoc": false,
            "outputDir": "storybook-static"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ngx-ds/**/*.ts", "projects/ngx-ds/**/*.html"],
            "eslintConfig": "projects/ngx-ds/eslint.config.js"
          }
        }
      }
    }
  }
}
