{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run watch)",
      "Bash(npm run storybook)",
      "Bash(npm run build-storybook)",
      "Bash(npm test)",
      "Bash(npx ng build *)",
      "Bash(npx ng test *)",
      "Bash(npx prettier *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(npm run build)",
      "PowerShell(npx ng build *)",
      "PowerShell(npx prettier *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "deny": [
      "Edit(/dist/**)",
      "Edit(/storybook-static/**)",
      "Edit(/.angular/**)",
      "Write(/dist/**)",
      "Write(/storybook-static/**)",
      "Write(/.angular/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-public-api.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
