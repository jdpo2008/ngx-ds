{
  "name": "ngx-ds",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "echo Use 'ng serve --project=<project-name>' to serve a specific project",
    "build": "ng build ngx-ds && tsc -p projects/ngx-ds/tsconfig.schematics.json",
    "watch": "ng build ngx-ds --watch --configuration development",
    "test": "ng test",
    "test:schematics": "vitest run --config projects/ngx-ds/schematics/vitest.config.mts",
    "storybook": "ng run ngx-ds:storybook",
    "build-storybook": "ng run ngx-ds:build-storybook",
    "test:a11y": "node scripts/storybook-a11y.mjs --warn color-contrast",
    "lint": "ng lint",
    "format": "prettier --write \"projects/ngx-ds/{src,stories,schematics}/**/*.{ts,cts,mts,html,scss,mdx}\"",
    "format:check": "prettier --check \"projects/ngx-ds/{src,stories,schematics}/**/*.{ts,cts,mts,html,scss,mdx}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "endOfLine": "auto",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2100.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-devkit/core": "^21.0.0",
    "@angular-devkit/schematics": "^21.2.10",
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@axe-core/playwright": "^4.14.0",
    "@compodoc/compodoc": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@schematics/angular": "^21.2.10",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/angular": "^10.3.6",
    "@types/node": "^25.7.0",
    "angular-eslint": "21.4.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.14",
    "prettier": "^3.10.1",
    "storybook": "^10.3.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
